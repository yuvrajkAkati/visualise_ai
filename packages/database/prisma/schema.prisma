generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  QUEUED
  PLANNING
  RENDERING
  COMPILING
  COMPLETED
  FAILED
}

enum SceneStatus {
  PENDING
  GENERATING
  RENDERING
  RENDERED
  FAILED
}

model Project {
  id        String        @id @default(cuid())
  title     String
  prompt    String        @db.Text
  status    ProjectStatus @default(QUEUED)
  progress  Int           @default(0)
  error     String?       @db.Text
  scenes    Scene[]
  video     Video?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Scene {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index       Int
  title       String
  description String      @db.Text
  code        String?     @db.Text
  status      SceneStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?     @db.Text
  clipPath    String?
  durationSec Float?
  messages    Json        @default("[]") // [{role:'user'|'assistant', content}] — codegen + refine history

  @@unique([projectId, index])
}

model Video {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path        String
  durationSec Float?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
}
