{
  "name": "manimate",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate",
    "db:migrate": "cd packages/database && bun --env-file=../../.env run db:migrate",
    "db:studio": "cd packages/database && bun --env-file=../../.env run db:studio",
    "pipeline:test": "bun run --filter worker pipeline:test"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
